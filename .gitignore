out_master/
__pycache__/
*.pyc

# Simulation state. Each pickle carries the per-shot correctness and stop-time
# matrices so the speedup analysis and the bootstrap can be redone without
# re-simulating, which makes them 8-11 MB each -- ~600 MB for the full
# experiment x detector matrix. Regenerate with `run`; the committed figures,
# CSVs and summaries under results/ are derived from them.
*.pkl

# Per-operating-point figures, 13 MB across the matrix. The sweep-level figures
# under results/ are committed; regenerate these with `plot`.
results/**/point_*.png

# Optimal-stopping run artifacts. The per-point pickle carries the full epoch
# filter paths, so they are large; regenerate with `optimal`. The committed
# CSVs and figures under results/ are derived from them.
results/**/optimal/*.pkl
